{
  "uid": "scrape-targets",
  "title": "Scrape targets",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Targets up",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "targets": [
        { "refId": "A", "expr": "count(up == 1)" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Targets per job",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "targets": [
        { "refId": "A", "expr": "count by (job) (up)", "legendFormat": "{{job}}" }
      ]
    }
  ]
}
