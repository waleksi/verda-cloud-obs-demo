{
  "uid": "batch-operations",
  "title": "Batch Operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "kueue"
  ],
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Kueue Quota Usage (CPU)",
      "description": "CPU requested by admitted workloads as a share of the ClusterQueue's nominal CPU quota.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kueue_cluster_queue_resource_usage{resource=\"cpu\"}) / sum(kueue_cluster_queue_nominal_quota{resource=\"cpu\"}) * 100",
          "legendFormat": "CPU quota used"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Quota usage over time (CPU cores)",
      "description": "Admitted CPU vs the ClusterQueue's nominal quota.",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster_queue) (kueue_cluster_queue_resource_usage{resource=\"cpu\"})",
          "legendFormat": "{{cluster_queue}} usage"
        },
        {
          "refId": "B",
          "expr": "sum by (cluster_queue) (kueue_cluster_queue_nominal_quota{resource=\"cpu\"})",
          "legendFormat": "{{cluster_queue}} quota"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Kueue Status",
      "description": "Workloads currently admitted (running within quota) vs waiting in the queue.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kueue_admitted_active_workloads) or vector(0)",
          "legendFormat": "Admitted"
        },
        {
          "refId": "B",
          "expr": "sum(kueue_pending_workloads) or vector(0)",
          "legendFormat": "Pending"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Admitted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pending"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Workloads over time",
      "description": "Admitted (running within quota) and pending (waiting) workloads across all queues.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kueue_admitted_active_workloads) or vector(0)",
          "legendFormat": "Admitted"
        },
        {
          "refId": "B",
          "expr": "sum(kueue_pending_workloads) or vector(0)",
          "legendFormat": "Pending"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 30,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Admitted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pending"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Admission wait time",
      "description": "How long workloads waited in the queue before Kueue admitted them.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(kueue_admission_wait_time_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kueue_admission_wait_time_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Running and pending jobs",
      "description": "Kueue Workloads that have not finished, read from /apis/kueue.x-k8s.io/v1beta2/workloads. Running = admitted by Kueue (time since admission), Pending = waiting for quota (time since created).",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "kubernetes-api"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/apis/kueue.x-k8s.io/v1beta2/workloads",
          "root_selector": "$append([], items[$not($exists(status.conditions[type=\"Finished\" and status=\"True\"]))].{\n  \"job\": metadata.ownerReferences[0].name,\n  \"namespace\": metadata.namespace,\n  \"queue\": spec.queueName,\n  \"state\": $exists(status.admission) ? \"Running\" : \"Pending\",\n  \"seconds\": $round(($millis() - $toMillis(($exists(status.admission) ? (status.conditions[type=\"Admitted\" and status=\"True\"].lastTransitionTime)[0] : metadata.creationTimestamp))) / 1000)\n})",
          "columns": [
            {
              "selector": "job",
              "text": "Job",
              "type": "string"
            },
            {
              "selector": "namespace",
              "text": "Namespace",
              "type": "string"
            },
            {
              "selector": "queue",
              "text": "Queue",
              "type": "string"
            },
            {
              "selector": "state",
              "text": "State",
              "type": "string"
            },
            {
              "selector": "seconds",
              "text": "Time in state",
              "type": "number"
            }
          ],
          "url_options": {
            "method": "GET",
            "data": "",
            "headers": [],
            "params": []
          },
          "filters": []
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Running": {
                        "color": "green",
                        "index": 0
                      },
                      "Pending": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time in state"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 8,
      "type": "alertlist",
      "title": "Pending and firing alerts",
      "description": "Alerts that are firing now, or whose condition is true but still waiting out its \"for\" period (alert state Pending, not to be confused with a Kueue workload being pending). Empty when everything is healthy.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "groupBy": [],
        "maxItems": 10,
        "sortOrder": 1,
        "dashboardAlerts": false,
        "alertName": "",
        "alertInstanceLabelFilter": "",
        "datasource": "default",
        "showInstances": true,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": false,
          "normal": false,
          "error": false
        },
        "folder": null
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Log Explorer: kueue-controller-manager",
      "description": "Logs from the kueue-controller-manager pod (VictoriaLogs).",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{kubernetes.pod_namespace=\"kueue\",kubernetes.container_name=\"manager\"} level:~`^(${level:pipe})$`",
          "queryType": "instant",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "level",
        "label": "Log level",
        "type": "custom",
        "description": "Filters the Log Explorer. Each choice also matches its variants (INFO, Level(-N) debug).",
        "query": "error : error, warn : warn|warning|WARN, info : info|INFO, debug : debug|Level.-[0-9]+.",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  }
}
