{
  "uid": "batch-operations",
  "title": "Batch Operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "kueue"
  ],
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Kueue Quota Usage (CPU)",
      "description": "CPU requested by admitted workloads as a share of the ClusterQueue's nominal CPU quota.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kueue_cluster_queue_resource_usage{resource=\"cpu\"}) / sum(kueue_cluster_queue_nominal_quota{resource=\"cpu\"}) * 100",
          "legendFormat": "CPU quota used"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Quota usage over time (CPU cores)",
      "description": "Admitted CPU vs the ClusterQueue's nominal quota.",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster_queue) (kueue_cluster_queue_resource_usage{resource=\"cpu\"})",
          "legendFormat": "{{cluster_queue}} usage"
        },
        {
          "refId": "B",
          "expr": "sum by (cluster_queue) (kueue_cluster_queue_nominal_quota{resource=\"cpu\"})",
          "legendFormat": "{{cluster_queue}} quota"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Kueue Status: Admitted vs Pending",
      "description": "Workloads currently admitted (running within quota) vs waiting in the queue.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kueue_admitted_active_workloads) or vector(0)",
          "legendFormat": "Admitted"
        },
        {
          "refId": "B",
          "expr": "sum(kueue_pending_workloads) or vector(0)",
          "legendFormat": "Pending"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Admitted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pending"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Running and pending jobs",
      "description": "Kueue Workloads that have not finished, read from /apis/kueue.x-k8s.io/v1beta2/workloads. Running = admitted by Kueue, Pending = waiting for quota.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "kubernetes-api"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "/apis/kueue.x-k8s.io/v1beta2/workloads",
          "root_selector": "$append([], items[$not($exists(status.conditions[type=\"Finished\" and status=\"True\"]))].{\n  \"job\": metadata.ownerReferences[0].name,\n  \"namespace\": metadata.namespace,\n  \"queue\": spec.queueName,\n  \"state\": $exists(status.admission) ? \"Running\" : \"Pending\"\n})",
          "columns": [
            {
              "selector": "job",
              "text": "Job",
              "type": "string"
            },
            {
              "selector": "namespace",
              "text": "Namespace",
              "type": "string"
            },
            {
              "selector": "queue",
              "text": "Queue",
              "type": "string"
            },
            {
              "selector": "state",
              "text": "State",
              "type": "string"
            }
          ],
          "url_options": {
            "method": "GET",
            "data": "",
            "headers": [],
            "params": []
          },
          "filters": []
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Running": {
                        "color": "green",
                        "index": 0
                      },
                      "Pending": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Log Explorer: kueue-controller-manager",
      "description": "Logs from the kueue-controller-manager pod (VictoriaLogs).",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{kubernetes.pod_namespace=\"kueue\",kubernetes.container_name=\"manager\"}",
          "queryType": "instant",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ]
}
