{
  "uid": "batch-operations",
  "title": "Batch Operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "kueue"
  ],
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Kueue Quota Usage (CPU)",
      "description": "CPU requested by admitted workloads as a share of the ClusterQueue's nominal CPU quota.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kueue_cluster_queue_resource_usage{resource=\"cpu\"}) / sum(kueue_cluster_queue_nominal_quota{resource=\"cpu\"}) * 100",
          "legendFormat": "CPU quota used"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Quota usage over time (CPU cores)",
      "description": "Admitted CPU vs the ClusterQueue's nominal quota.",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cluster_queue) (kueue_cluster_queue_resource_usage{resource=\"cpu\"})",
          "legendFormat": "{{cluster_queue}} usage"
        },
        {
          "refId": "B",
          "expr": "sum by (cluster_queue) (kueue_cluster_queue_nominal_quota{resource=\"cpu\"})",
          "legendFormat": "{{cluster_queue}} quota"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Kueue Status: Admitted vs Pending",
      "description": "Workloads currently admitted (running within quota) vs waiting in the queue.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kueue_admitted_active_workloads) or vector(0)",
          "legendFormat": "Admitted"
        },
        {
          "refId": "B",
          "expr": "sum(kueue_pending_workloads) or vector(0)",
          "legendFormat": "Pending"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Admitted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pending"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Log Explorer: kueue-controller-manager",
      "description": "Logs from the kueue-controller-manager pod (VictoriaLogs).",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{kubernetes.pod_namespace=\"kueue\",kubernetes.container_name=\"manager\"}",
          "queryType": "instant",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ]
}
